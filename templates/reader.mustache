{{!
    @template mod_underlyit/reader

    Reader of an Underly.it activity: toolbar, document outline and reading area.
    The document is rendered into the reading area by the mod_underlyit/app module.

    Context variables required for this template:
    * canhighlight - Whether the user can highlight
    * canmanage - Whether the user is a tutor (reference mode, visibility and report)
    * showreference - Whether learners can see the tutor reference
    * learnerreferencetoggle - Whether to show the learner's show/hide reference button
    * colors - Highlight colours: value, name and selected
    * reporturl - URL of the highlighting report
    * courseurl - URL of the course

    Example context (json):
    {
        "canhighlight": true,
        "canmanage": true,
        "showreference": false,
        "learnerreferencetoggle": false,
        "colors": [
            {"value": "#fff176", "name": "Yellow", "selected": true},
            {"value": "#90caf9", "name": "Blue", "selected": false}
        ],
        "reporturl": "https://example.com/mod/underlyit/report.php?id=1",
        "courseurl": "https://example.com/course/view.php?id=2"
    }
}}
<div class="mod-underlyit-app" id="underlyit-app">
    <nav class="underlyit-reader-toolbar" aria-label="{{#str}}readertools, mod_underlyit{{/str}}">
        {{#canhighlight}}
        <div class="underlyit-color-picker" role="group" aria-label="{{#str}}highlightcolor, mod_underlyit{{/str}}">
            <span class="underlyit-color-picker-label">{{#str}}highlightcolor, mod_underlyit{{/str}}</span>
            {{#colors}}
            <button type="button" class="underlyit-color-swatch{{#selected}} active{{/selected}}" data-highlight-color="{{value}}"
                    aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}"
                    aria-label="{{name}}" title="{{name}}" style="--underlyit-swatch: {{value}}"><span aria-hidden="true"></span></button>
            {{/colors}}
            <button type="button" class="underlyit-highlight-delete" data-action="delete-highlight"
                    aria-label="{{#str}}deletehighlight, mod_underlyit{{/str}}" title="{{#str}}deletehighlight, mod_underlyit{{/str}}"
                    hidden disabled>
                <svg class="underlyit-icon" aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M6 7h12l-1 14H7L6 7m3-4h6l1 2h4v2H4V5h4l1-2"/></svg>
            </button>
        </div>
        {{/canhighlight}}
        <div class="underlyit-toolbar-actions">
            <button type="button" class="btn btn-icon btn-outline-secondary" data-action="toggle-outline" aria-expanded="true"
                    aria-label="{{#str}}hideoutline, mod_underlyit{{/str}}" title="{{#str}}hideoutline, mod_underlyit{{/str}}">
                <svg class="underlyit-icon" aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M3 5h3v3H3V5m5 0h13v3H8V5M3 10.5h3v3H3v-3m5 0h13v3H8v-3M3 16h3v3H3v-3m5 0h13v3H8v-3"/></svg>
            </button>
            <button type="button" class="btn btn-icon btn-outline-secondary" data-action="summary" disabled aria-pressed="false"
                    aria-label="{{#str}}summaryreading, mod_underlyit{{/str}}" title="{{#str}}summaryreading, mod_underlyit{{/str}}">
                <svg class="underlyit-icon" data-icon="summary" aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M4 5h16v2H4V5m0 4h10v2H4V9m0 4h16v2H4v-2m0 4h10v2H4v-2"/></svg>
                <svg class="underlyit-icon" data-icon="full" aria-hidden="true" viewBox="0 0 24 24" hidden><path fill="currentColor" d="M4 4h16v2H4V4m0 4h16v2H4V8m0 4h16v2H4v-2m0 4h16v2H4v-2"/></svg>
            </button>
            <a class="btn btn-icon btn-outline-secondary" data-action="original" href="#" target="_blank" rel="noopener"
                    aria-label="{{#str}}originaldocument, mod_underlyit{{/str}}" title="{{#str}}originaldocument, mod_underlyit{{/str}}">
                <svg class="underlyit-icon" aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M6 2h9l5 5v15H6V2m8 1.5V8h4.5L14 3.5M8 12v2h8v-2H8m0 4v2h8v-2H8"/></svg>
            </a>
            {{#canmanage}}
            <button type="button" class="btn btn-icon btn-outline-secondary active" data-action="reference" aria-pressed="true"
                    aria-label="{{#str}}referencemodeactive, mod_underlyit{{/str}}" title="{{#str}}referencemodeactive, mod_underlyit{{/str}}">
                <svg class="underlyit-icon" aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2"/></svg>
            </button>
            <button type="button" class="btn btn-icon btn-outline-secondary{{#showreference}} active{{/showreference}}" data-action="reference-visibility"
                    aria-pressed="{{#showreference}}true{{/showreference}}{{^showreference}}false{{/showreference}}"
                    {{#showreference}}aria-label="{{#str}}hidereference, mod_underlyit{{/str}}" title="{{#str}}hidereference, mod_underlyit{{/str}}"{{/showreference}}
                    {{^showreference}}aria-label="{{#str}}showreference, mod_underlyit{{/str}}" title="{{#str}}showreference, mod_underlyit{{/str}}"{{/showreference}}>
                {{> mod_underlyit/icon_visibility}}
            </button>
            <a class="btn btn-icon btn-outline-secondary" href="{{reporturl}}"
                    aria-label="{{#str}}analytics, mod_underlyit{{/str}}" title="{{#str}}analytics, mod_underlyit{{/str}}">
                <svg class="underlyit-icon" aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M3 3h2v18H3V3m4 10h3v8H7v-8m5-6h3v14h-3V7m5 3h3v11h-3V10"/></svg>
            </a>
            {{/canmanage}}
            {{#learnerreferencetoggle}}
            <button type="button" class="btn btn-icon btn-outline-secondary active" data-action="toggle-reference-view" aria-pressed="true"
                    aria-label="{{#str}}hidereferenceview, mod_underlyit{{/str}}" title="{{#str}}hidereferenceview, mod_underlyit{{/str}}">
                {{> mod_underlyit/icon_visibility}}
            </button>
            {{/learnerreferencetoggle}}
            <a class="btn btn-icon btn-outline-secondary" href="{{courseurl}}"
                    aria-label="{{#str}}exittocourse, mod_underlyit{{/str}}" title="{{#str}}exittocourse, mod_underlyit{{/str}}">
                <svg class="underlyit-icon" aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h5v-2H5V5h5V3m4.59 4.59L16 9l-3 3H7v2h6l3 3 1.41-1.41L16.83 15H21v-2h-4.17l.58-.59L16 11l-1.41 1.41L14 13h-1l3-3-1.41-1.41Z"/></svg>
            </a>
            <button type="button" class="btn btn-icon btn-outline-secondary" data-action="toggle-focus"
                    aria-label="{{#str}}togglefullscreen, mod_underlyit{{/str}}" title="{{#str}}togglefullscreen, mod_underlyit{{/str}}">
                <svg class="underlyit-icon" aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M4 4h6v2H6v4H4V4m10 0h6v6h-2V6h-4V4M4 14h2v4h4v2H4v-6m14 0h2v6h-6v-2h4v-4"/></svg>
            </button>
        </div>
    </nav>
    <div class="underlyit-layout">
        <nav class="underlyit-outline" aria-label="{{#str}}documentoutline, mod_underlyit{{/str}}">
            <h2>{{#str}}outline, mod_underlyit{{/str}}</h2>
            <div data-region="outline"></div>
        </nav>
        <main class="underlyit-reader">
            <div data-region="viewer" class="underlyit-empty">{{#str}}loadingdocument, mod_underlyit{{/str}}</div>
        </main>
    </div>
</div>
