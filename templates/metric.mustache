{{!
    @template mod_underlyit/metric

    One metric of a learner in the highlighting report: value, bar and difference from the course average.

    Context variables required for this template:
    * label - Metric name
    * value - Formatted percentage
    * width - Bar width, 0 to 100
    * state - Bootstrap state of the value
    * difference - Object with arrow, value and class

    Example context (json):
    {
        "label": "Document progress",
        "value": "62.5%",
        "width": 62.5,
        "state": "warning",
        "difference": {"arrow": "↑", "value": "+4.0%", "class": "text-success"}
    }
}}
<div class="underlyit-metric">
    <div class="underlyit-metric-heading">
        <span>{{label}}</span>
        <span class="badge badge-{{state}} text-bg-{{state}}">{{value}}</span>
    </div>
    <div class="progress underlyit-progress-point" role="progressbar" aria-label="{{label}}"
            aria-valuenow="{{width}}" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar bg-{{state}}" style="width: {{width}}%"></div>
        <span class="underlyit-progress-marker" style="left: {{width}}%"></span>
    </div>
    {{#difference}}
    <small class="underlyit-metric-difference {{class}}">{{arrow}} {{value}} {{#str}}comparedaverage, mod_underlyit{{/str}}</small>
    {{/difference}}
</div>
