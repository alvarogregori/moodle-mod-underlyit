{{!
    @template mod_underlyit/outline

    Document outline built by the reader from the headings of the document.

    Context variables required for this template:
    * headings - List of headings: id, level and text
    * hasheadings - Whether the document has headings

    Example context (json):
    {
        "hasheadings": true,
        "headings": [
            {"id": "underlyit-block-0", "level": 1, "text": "Introduction"},
            {"id": "underlyit-block-4", "level": 2, "text": "Method"}
        ]
    }
}}
{{#headings}}
<a class="underlyit-outline-link level-{{level}}" href="#{{id}}" data-outline-id="{{id}}"><span class="underlyit-outline-marker" aria-hidden="true"></span>{{text}}</a>
{{/headings}}
{{^hasheadings}}
<p class="text-muted small">{{#str}}noheadings, mod_underlyit{{/str}}</p>
{{/hasheadings}}
